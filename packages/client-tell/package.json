{
  "name": "@dsh-error-tell/client-tell",
  "version": "0.1.8",
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./host": "./src/host.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@dsh-error-tell/core": "workspace:*"
  },
  "description": "DSH web 看门狗：加载页注入 + errorTell 端点 + 设置页「错误看门狗」分区（读取插件/手动禁用恢复）",
  "author": "dphmoblie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dphmoblie/dsh-error-tell.git"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
