{
  "name": "dsh-error-tell",
  "private": true,
  "version": "0.1.0",
  "description": "DSH 启动自检：检测并持久化禁用问题插件，让 dsh web 正常打开",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test packages/boot-guard/test/*.test.mjs packages/runtime-guard/test/*.test.mjs test/inject.test.mjs",
    "e2e": "node test/e2e/run-e2e.mjs",
    "e2e:cd": "node test/e2e/verify-cd.mjs",
    "e2e:efg": "node test/e2e/verify-efg.mjs",
    "e2e:s2a": "node test/e2e/verify-s2a.mjs",
    "e2e:s2b": "node test/e2e/verify-s2b.mjs",
    "e2e:s3c": "node test/e2e/verify-s3c.mjs",
    "e2e:c": "node test/e2e/verify-c.mjs",
    "e2e:d": "node test/e2e/verify-d.mjs"
  }
}
